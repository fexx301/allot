# True Markets Gateway Organization API Key
# Option A (local dev): path to downloaded dashboard JSON key file (outside repo)
TM_KEY_FILE=/Users/femi/.config/truemarkets/allot-org-key.json

# Option B (cloud deploy e.g. Vercel fra1 / Fly ams): inline JSON string or base64 JSON
# TM_ORG_KEY_JSON={"key_id":"...","private_key":{...}}

# Optional: Gateway base URL (defaults to https://api.truemarkets.co)
TM_API_BASE=https://api.truemarkets.co

# Default preview/probe Gateway user_id used for live quote lookups when no wallet is connected
TM_QUOTE_USER_ID=98f6006a-b96a-4b77-a9e8-69c1c85c308c
